{
  "name": "bert-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm run server\" \"wait-on tcp:127.0.0.1:8787 && npm run dev\"",
    "start": "node server/server.mjs",
    "start:api": "node server/server.mjs",
    "server": "node server/server.mjs",
    "google:connect": "node scripts/print-google-connect-urls.mjs",
    "build": "tsc -b && vite build",
    "check:server": "node --check server/server.mjs",
    "seed:master": "node scripts/seed-master.mjs",
    "migrate:userauth": "node scripts/migrate-userauth-passwords.mjs",
    "verify:auth": "node scripts/verify-auth-hardening.mjs",
    "verify:password-reset": "node scripts/verify-password-reset.mjs",
    "verify:offline-shell": "node scripts/verify-offline-shell.mjs",
    "verify:offline-tablet": "node scripts/verify-offline-tablet.mjs",
    "verify:check-completion": "node scripts/verify-check-completion.mjs",
    "verify:pilot-readiness": "node scripts/verify-pilot-readiness.mjs",
    "verify:godmode-company-context": "node scripts/verify-godmode-company-context.mjs",
    "verify:google-form-templates": "node scripts/verify-google-form-templates.mjs",
    "verify:template-languages": "node scripts/verify-template-languages.mjs",
    "verify:company-folder-structure": "node scripts/verify-company-folder-structure.mjs",
    "verify:company-setup-progress": "node scripts/verify-company-setup-progress.mjs",
    "verify:company-onboarding": "node scripts/verify-company-onboarding.mjs",
    "verify:company-setup-persistence": "node scripts/verify-company-setup-persistence.mjs",
    "verify:invite-target": "node scripts/verify-invite-target.mjs",
    "verify:invite-permissions": "node scripts/verify-invite-permissions.mjs",
    "verify:invite-workspace": "node scripts/verify-invite-workspace.mjs",
    "verify:schedule-auditors": "node scripts/verify-schedule-auditors.mjs",
    "verify:schedule-assignees": "node scripts/verify-schedule-assignees.mjs",
    "verify:shared-drive-workspace": "node scripts/verify-shared-drive-workspace.mjs",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "bash scripts/build-android-debug-apk.sh",
    "android:apk:release": "bash scripts/build-android-release-apk.sh",
    "android:apk:pilot": "bash scripts/build-android-pilot-release-apk.sh",
    "android:apk:pilot:debug": "bash scripts/build-android-pilot-debug-apk.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "nodemailer": "^8.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
