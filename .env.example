# --- Local development (default) ---
# Client API origin: leave empty for same-origin `/api` (Vite dev server proxies to the local API).
# Android paid pilot against hosted API: set at build time, e.g. VITE_API_BASE_URL=https://api.usebert.co.uk
# VITE_API_BASE_URL=https://api.usebert.co.uk
VITE_API_BASE_URL=
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
FRONTEND_URL=http://127.0.0.1:5173
# Customer-facing support inbox for server-generated notifications (incidents, etc.). Optional alias: APP_ADMIN_EMAIL.
APP_SUPPORT_EMAIL=admin@usebert.co.uk
# Full product line for emails, invites, and sign-in screens (short name — tagline).
APP_BRAND_NAME=BERT — Business. Evaluate. Report. Tool.
# Short name shown in the app shell; client tagline is "Business. Evaluate. Report. Tool." (bert.).
VITE_APP_NAME=bert.
# If this is ever set to the legacy template value, Vite normalizes it to empty at build time so the bundle stays clean; the app falls back to bert.
# App auth mode for ops visibility. Current builds use client-side demo auth; production still warns if unset/demo.
APP_AUTH_MODE=demo
# APP_AUTH_MODE=provider
GOOGLE_SHARED_DRIVE_ID=your-google-root-folder-id
GOOGLE_ONBOARDING_FORM_ID=your-master-onboarding-form-id
GOOGLE_ONBOARDING_SHEET_ID=your-master-onboarding-response-sheet-id
# Throttle back-to-back Sheets reads (values.get / spreadsheets.get). Default 500; raise (e.g. 800–1200) if you hit per-minute read quota in dev.
SHEETS_READ_GAP_MS=500
# Optional: extra quota retries (default 8). Lower only for faster failure in tests.
# SHEETS_QUOTA_MAX_RETRIES=8
SESSION_SECRET=replace-this-with-a-long-random-secret
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=BERT
# --- Demo / local client auth (never ship real passwords; not used when VITE_ENABLE_DEMO_LOGIN is unset in prod builds) ---
VITE_GODMODE_USERNAME=master
# VITE_GODMODE_PASSWORD=set-for-local-demo-master-only
# VITE_DEMO_USER_PASSWORD=set-for-admin-manager-tom-demo-only
VITE_ENABLE_DEMO_ROLE_SWITCH=true
# Optional: also show debug chrome when not in dev (e.g. staging). In `npm run dev`, debug chrome is on by default.
# VITE_SHOW_DEBUG_UI=true

# --- Platform Master (BERT internal operators; server-side only, `.sessions/master-operators.json`) ---
# Long random string proving intentional access when running: npm run seed:master -- --email ... --password ... --confirm
# BERT_MASTER_SEED_SECRET=minimum-sixteen-chars-random
# Optional: Master signed cookie lifetime (default 7d). MASTER_SESSION_TTL_MS=604800000

# Optional: bulk-hash legacy plaintext `UserAuth.*` in Config (script uses .sessions/google-session.json).
# npm run migrate:userauth -- <masterSpreadsheetId>
# Optional: HTTP tool (requires API Google session + header). Set BERT_TOOL_SECRET in server env.
# BERT_TOOL_SECRET=long-random-secret
# Optional: company user signed cookie TTL (default 7d). COMPANY_USER_SESSION_TTL_MS=604800000

# --- Production (hosted API) ---
# See docs/deployment-runbook.md for paid-pilot deployment setup and health/readiness checks.
# Ephemeral disks (Render/Railway): mount a persistent volume and point the API at it, or sessions are lost on redeploy.
# BERT_SESSIONS_DIR=/path/to/persistent/bert-sessions
# NODE_ENV=production
# Comma-separated exact Origins for credentialed fetch (no wildcard with credentials). Include app host, Capacitor, and local dev if needed:
# BERT_ALLOWED_ORIGINS=https://app.usebert.co.uk,capacitor://localhost,http://localhost:4173,http://localhost:5173
# Optional: force SameSite=None; Secure session cookies when NODE_ENV is not production (e.g. HTTPS staging). Implied when NODE_ENV=production.
# BERT_COOKIE_SAMESITE_NONE=true
# The API refuses to start in production if SESSION_SECRET is missing, is the local default, or is shorter than 24 characters.
# SESSION_SECRET=replace-with-long-random-secret-min-24-chars
# Do not set ALLOW_INSECURE_OAUTH_STATE=true in production.
# FRONTEND_URL=https://app.yourdomain.com
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/google/callback
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_SHARED_DRIVE_ID=...
# See docs/production-launch-checklist.md for /api/health vs /api/readiness and deploy smoke tests.
